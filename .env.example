# ============================================================
# Classroom Attendance System - Environment Configuration Template
# ============================================================
# Copy this file to .env and populate variable values.
# NEVER commit .env or credentials to version control.
# ============================================================

# --- Core Security ---
# Flask session secret key (generate a strong random string)
SECRET_KEY=generate-a-long-random-string-for-production

# --- Database Configuration (Railway/Cloud) ---
# DATABASE_URL takes priority (e.g. mysql://user:pass@host:port/db)
DATABASE_URL=mysql://user:password@host:3306/classroom_db

# Fallback discrete variables
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=classroom_db

# --- SMTP Configuration (Email Notifications) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Passwords for Web Dashboard Users ---
# Set these to override default development passwords
PASS_ADMIN=
PASS_CSD_HOD=
PASS_CSE_HOD=
PASS_EEE_HOD=
PASS_ECE_HOD=

# --- Department Camera Sources ---
# Comma-separated list of webcam index (e.g. 0), RTSP URL, or video file path per department.
# Use CAMERA_{DEPT_CODE}
CAMERA_CSD=0

# --- Storage Configuration ---
# 'local' or 's3'
STORAGE_BACKEND=local
STUDENTS_BASE_DIR=students

# S3 Configuration (only if STORAGE_BACKEND=s3)
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Face Recognition Parameters ---
# Distance threshold (lower = stricter, range: 0.4 to 0.6)
RECOGNITION_THRESHOLD=0.5

# --- Performance Tuning ---
FRAME_SKIP=3
FACE_RESIZE_FACTOR=0.5

# --- Environment ---
# 'development' or 'production'
ENVIRONMENT=production
PORT=5000
