# ============================================================
# Classroom Attendance System - Production Environment Template
# ============================================================
# Copy this file to .env and populate variable values.
# NEVER commit .env or credentials to version control.
# ============================================================

# --- Production Environment & Server Port ---
ENVIRONMENT=production
PORT=5000

# --- Flask Secret Key ---
SECRET_KEY=your_strong_random_secret_key_here

# --- Cloud Database Configuration ---
# Option 1: Complete connection URL (MySQL / PostgreSQL URL)
DATABASE_URL=mysql://db_user:db_password@db_host:3306/classroom_db

# Option 2: Individual Connection Fields
DB_HOST=localhost
DB_PORT=3306
DB_NAME=classroom_db
DB_USER=root
DB_PASSWORD=your_secure_db_password_here

# --- SMTP Email Notification Settings ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_smtp_app_password_here
SMTP_FROM=your_email@example.com

# --- CORS & Security Settings ---
CORS_ORIGINS=*

# --- Camera & RTSP Stream Configuration ---
# Camera index (e.g. 0) or RTSP URL per department
CAMERA_CSD=0

# --- Storage & Recognition Settings ---
STUDENTS_BASE_DIR=students
RECOGNITION_THRESHOLD=0.5
FRAME_SKIP=3
FACE_RESIZE_FACTOR=0.5
