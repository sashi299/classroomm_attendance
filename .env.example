# ============================================================
# Classroom Attendance System - Production Environment Template
# ============================================================
# Copy this file to .env and populate variable values.
# NEVER commit .env or credentials to version control.
# ============================================================

# --- Production Environment & Server Port ---
ENVIRONMENT=production
PORT=5000

# --- Flask Secret Key ---
SECRET_KEY=your_strong_random_secret_key_here

# --- Cloud Database Configuration ---
# Option 1: Complete connection URL (MySQL)
# Railway provides this automatically as MYSQL_URL or DATABASE_URL
DATABASE_URL=mysql://root:password@localhost:3306/classroom_db

# Option 2: Individual Connection Fields
DB_HOST=localhost
DB_PORT=3306
DB_NAME=classroom_db
DB_USER=root
DB_PASSWORD=

# --- SMTP Email Notification Settings ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- CORS & Security Settings ---
CORS_ORIGINS=*

# --- Camera & RTSP Stream Configuration ---
# Camera index (e.g. 0) or RTSP URL per department
CAMERA_CSD=0

# --- Storage Configuration ---
# 'local' or 's3'
STORAGE_BACKEND=local
STUDENTS_BASE_DIR=students

# S3 Configuration (if STORAGE_BACKEND=s3)
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Recognition & Performance Settings ---
RECOGNITION_THRESHOLD=0.5
FRAME_SKIP=3
FACE_RESIZE_FACTOR=0.5
